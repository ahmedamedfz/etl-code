    {"rule": "SYSTEM_NO_INPUT", "description": "System nodes cannot receive input", "severity": "error", "code": "GRAPH_005"},
    {"rule": "MIN_ONE_SOURCE", "description": "At least one source or system node required", "severity": "error", "code": "GRAPH_006"},
    {"rule": "MIN_ONE_TARGET", "description": "At least one target node recommended", "severity": "warning", "code": "GRAPH_007"}
  ],
  "nodeValidation": [
    {"rule": "REQUIRED_PROPERTIES", "description": "Node must have id, type, and data", "severity": "error", "code": "NODE_001"},
    {"rule": "VALID_NODE_TYPE", "description": "Node type must be source|transformer|target|system", "severity": "error", "code": "NODE_002"},
    {"rule": "VALID_SUBTYPE", "description": "Node subtype must match allowed values", "severity": "error", "code": "NODE_003"},
