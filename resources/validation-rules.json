    {"rule": "VALID_HANDLES", "description": "Handles must reference existing fields", "severity": "error", "code": "EDGE_003"},
    {"rule": "NO_DUPLICATES", "description": "No duplicate edges", "severity": "error", "code": "EDGE_004"},
