    {"rule": "VALID_CONNECTION_DIRECTION", "description": "Connection must follow data flow rules", "severity": "error", "code": "EDGE_006"},
    {"rule": "SINGLE_INPUT_CONSTRAINT", "description": "Non-join/union transformers accept single input", "severity": "error", "code": "EDGE_007"}
