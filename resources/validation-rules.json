    {"rule": "VALID_FIELDS", "description": "Fields must have id, name, and type", "severity": "error", "code": "NODE_005"},
    {"rule": "UNIQUE_FIELD_IDS", "description": "Field IDs must be unique within node", "severity": "error", "code": "NODE_006"},
